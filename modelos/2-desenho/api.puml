@startuml api
hide circle
hide empty members
skinparam classAttributeIconSize 0


interface ICheckoutLN <<interface>> {
    + abrirCompra(codCartao: CodigoCartao): CodigoCompra
    + adicionarArtigo(codCompra: CodigoCompra, codEtiqueta: CodigoEtiqueta): float
    + terminarCompra(codCompra: CodigoCompra): void
    + iniciarPagamento(codCompra: CodigoCompra): boolean
    + obterArtigosCompra(codCompra: CodigoCompra): List<LinhaCompra>
    + registarResultadoVerificacao(codCompra: CodigoCompra, resultado: ResultadoVerificacao): void
    + calcularTotalAPagar(codCompra: CodigoCompra): float
    + pagar(codCompra: CodigoCompra, codMeio: String): float
    + concluirCompra(codCompra: CodigoCompra): void
}

interface ISubClientes <<interface>> {
    + existeCartao(codCartao: CodigoCartao): boolean
    + debitarSaldo(codCartao: CodigoCartao, valorMaximo: float): float
}

interface ISubCompras <<interface>> {
    + abrirCompra(codCartao: CodigoCartao): CodigoCompra
    + obterCompra(codCompra: CodigoCompra): Compra
    + adicionarArtigo(codCompra: CodigoCompra, artigo: Artigo, preco: float): float
    + terminarCompra(codCompra: CodigoCompra): void
    + contarComprasPagas(codCartao: CodigoCartao): int
    + calcularValorTotal(codCompra: CodigoCompra): float
    + concluirCompra(codCompra: CodigoCompra): void
    + suspenderPagamento(codCompra: CodigoCompra): void
    + obterArtigosCompra(codCompra: CodigoCompra): List<LinhaCompra>
    + desbloquearPagamento(codCompra: CodigoCompra): void
    + marcarNaoAdmissivel(codCompra: CodigoCompra): void
    + registarDesconto(codCompra: CodigoCompra, desconto: float): void
    + registarPagamento(codCompra: CodigoCompra, codMeio: String, valor: float): void
}

interface ISubArtigos <<interface>> {
    + lerEtiqueta(codEtiqueta: CodigoEtiqueta): Etiqueta
}

interface ISubCampanhas <<interface>> {
    + aplicarCampanhas(codCompra: CodigoCompra): float
}

interface ISubVerificacoes <<interface>> {
    + decidirVerificacao(codCompra: CodigoCompra, nComprasPagas: int): boolean
    + registarResultadoVerificacao(codCompra: CodigoCompra, resultado: ResultadoVerificacao): void
}

interface ISubPagamentos <<interface>> {
    + pagar(codCompra: CodigoCompra, codMeio: String): float
}

@enduml
